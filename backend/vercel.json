{
  "version": 2,
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/health"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/auth/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/zendesk/:path*",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/zendesk-hourly-sync",
      "schedule": "0 0 * * *"
    }
  ]
}