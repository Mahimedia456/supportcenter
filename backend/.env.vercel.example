# ==============================
# Vercel production additions
# ==============================

# Optional browser/admin origins, comma-separated.
# Native React Native mobile calls do not require browser CORS.
# Example:
# CORS_ORIGINS=https://admin.example.com,https://example.com

# Existing backend variables still belong in Vercel Environment Variables:
# SUPABASE_URL=
# SUPABASE_DATABASE_URL=
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# AAMIR_PASSWORD=
# SHAHID_PASSWORD=
# ANGELBIRD_ZENDESK_SUBDOMAIN=
# ANGELBIRD_ZENDESK_EMAIL=
# ANGELBIRD_ZENDESK_API_TOKEN=
# ATOMOS_ZENDESK_SUBDOMAIN=
# ATOMOS_ZENDESK_EMAIL=
# ATOMOS_ZENDESK_API_TOKEN=
