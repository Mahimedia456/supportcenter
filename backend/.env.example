PORT=3000

# Project REST URL. Do NOT put this value into SUPABASE_DATABASE_URL.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# PostgreSQL URI from Supabase Dashboard > Connect.
# Prefer Session pooler on normal Windows/IPv4 networks.
SUPABASE_DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require

JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
AAMIR_PASSWORD=CHANGE_ME
SHAHID_PASSWORD=CHANGE_ME

# Use only the subdomain slug, not https://...zendesk.com
ANGELBIRD_ZENDESK_SUBDOMAIN=
ANGELBIRD_ZENDESK_EMAIL=
ANGELBIRD_ZENDESK_API_TOKEN=

ATOMOS_ZENDESK_SUBDOMAIN=atomos
ATOMOS_ZENDESK_EMAIL=
ATOMOS_ZENDESK_API_TOKEN=
