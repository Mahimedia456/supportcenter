{
  "expo": {
    "name": "Support Command Center",
    "slug": "support-command-center",
    "version": "0.2.3",
    "orientation": "portrait",
    "scheme": "supportcommandcenter",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/brand/app-icon.png",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F7FCFA"
    },
    "android": {
      "package": "com.mahimediasolutions.supportcommandcenter",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon-foreground.png",
        "backgroundImage": "./assets/brand/adaptive-icon-background.png",
        "backgroundColor": "#075F55",
        "monochromeImage": "./assets/brand/adaptive-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "ios": {
      "bundleIdentifier": "com.mahimediasolutions.supportcommandcenter",
      "buildNumber": "4",
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7FCFA"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}